# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# OAuth Client ID (tipo "Web application") do Google Cloud Console, usado
# pra conectar a Google Agenda em modo leitura. Ver README > Google Agenda.
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
